{
  "name": "zotero-plugin-template",
  "type": "module",
  "version": "1.6.0",
  "description": "Adds split-view reading for same or different PDFs with optional primary-view action sync",
  "config": {
    "addonName": "Split-View Reader",
    "addonID": "zotero-split-view-reader@fuling.lin.at.outlook.com",
    "addonRef": "zotero-split-view-reader",
    "addonInstance": "ZoteroSplitViewReader",
    "prefsPrefix": "extensions.zotero.${addonRef}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerolfl/zotero-split-view-reader.git"
  },
  "author": "Fuling Lin",
  "bugs": {
    "url": "https://github.com/zerolfl/zotero-split-view-reader/issues"
  },
  "homepage": "https://github.com/zerolfl/zotero-split-view-reader#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:compat": "node scripts/test-compat.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "test:unit": "node --test test/unit/*.test.cjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "6.0.3"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
