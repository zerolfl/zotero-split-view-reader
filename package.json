{
  "name": "zotero-plugin-template",
  "type": "module",
  "version": "1.3.0",
  "description": "Adds split-view reading for same or different PDFs with optional primary-view action sync",
  "config": {
    "addonName": "Split-View Reader",
    "addonID": "zotero-split-view-reader@fuling.lin.at.outlook.com",
    "addonRef": "zotero-split-view-reader",
    "addonInstance": "ZoteroSplitViewReader",
    "prefsPrefix": "extensions.zotero.${addonRef}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerolfl/zotero-split-view-reader.git"
  },
  "author": "Fuling Lin",
  "bugs": {
    "url": "https://github.com/zerolfl/zotero-split-view-reader/issues"
  },
  "homepage": "https://github.com/zerolfl/zotero-split-view-reader#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.1",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
